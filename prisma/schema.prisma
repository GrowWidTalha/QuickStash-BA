// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// User model (extends Supabase auth.users)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatarUrl String   
  
  // Supabase auth user ID
  supabaseUserId String? @unique
  
  // Relations
  saves Save[]
  
  @@map("users")
}

// Saved content model
model Save {
  id          String   @id @default(cuid())
  title       String?
  url         String
  excerpt     String?
  favicon_url String?
  isArchived  Boolean  @default(false)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  featured_image_url String?
  isFetchingAllowed Boolean  @default(false)

  // Extractability flags (nullable to represent unknown)
  isExtractable              Boolean?
  extractabilityReason       String?
  blockedBy                  String?  // comma-separated list: robots,meta,xrobots,status_403,status_451,rate_limit,other
  extractionMethod           String?  // e.g., webview_readability, amp_readability, fallback_preview
  extractabilityCheckedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saves")
}

// Optional: cache of domain-level policies/signals
model DomainPolicy {
  domain                String    @id
  robots_txt            String?
  robots_disallow_paths Json?
  has_noai              Boolean?  // derived from X-Robots-Tag or meta robots on representative pages
  checked_at            DateTime  @default(now())
  ttl_expires_at        DateTime?

  @@map("domain_policies")
}

model ExtractionTelemetry {
  id              String   @id @default(cuid())
  url             String
  attempted       Boolean
  success         Boolean
  method          String?
  failure_reason  String?
  status_from_api String?   // e.g., allowed/disallowed/unknown observed at time
  createdAt       DateTime @default(now())

  @@map("extraction_telemetry")
}
